# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase
# (Project Settings → API). NUNCA commite o ".env" de verdade.

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-publicavel
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Qualquer string longa e aleatória, usada para assinar o cookie de sessão.
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Mercado Pago (Developers → Suas integrações → sua aplicação → Credenciais de teste)
MERCADOPAGO_ACCESS_TOKEN=seu-access-token-de-teste
# Settings → Webhooks → Chave secreta (aparece depois de configurar a URL de notificação)
MERCADOPAGO_WEBHOOK_SECRET=sua-chave-secreta-do-webhook
